diff --git a/src/playsim/p_actionfunctions.cpp b/src/playsim/p_actionfunctions.cpp
index cb99d56..bcce8ca 100644
--- a/src/playsim/p_actionfunctions.cpp
+++ b/src/playsim/p_actionfunctions.cpp
@@ -5623,4 +5623,17 @@ DEFINE_ACTION_FUNCTION(AActor, AttackDir)
 	PARAM_ANGLE(pitch);
 	DVector3 dir = self->AttackDir(source, yaw, pitch);
 	ACTION_RETURN_VEC3(DVector3(dir.Angle().Degrees(), dir.Pitch().Degrees(), 0.));
-}
\ No newline at end of file
+}
+
+// QuestZDoom compatibility (2026-10-29): the off hand's version of AttackDir. Returns angle and pitch, like AttackDir.
+DEFINE_ACTION_FUNCTION(AActor, OffhandDir)
+{
+	PARAM_SELF_STRUCT_PROLOGUE(AActor);
+	PARAM_OBJECT_NOT_NULL(source, AActor);
+	PARAM_ANGLE(yaw);
+	PARAM_ANGLE(pitch);
+	if (self->OffhandDir == nullptr)		// not in VR: the actor's own aim
+		ACTION_RETURN_VEC3(DVector3(yaw.Degrees(), pitch.Degrees(), 0.));
+	DVector3 dir = self->OffhandDir(source, yaw, pitch);
+	ACTION_RETURN_VEC3(DVector3(dir.Angle().Degrees(), dir.Pitch().Degrees(), 0.));
+}
