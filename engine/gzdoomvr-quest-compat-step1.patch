diff --git a/src/rendering/gl/stereo3d/gl_openvr.cpp b/src/rendering/gl/stereo3d/gl_openvr.cpp
index 7af05e4..d6a1c53 100644
--- a/src/rendering/gl/stereo3d/gl_openvr.cpp
+++ b/src/rendering/gl/stereo3d/gl_openvr.cpp
@@ -1244,6 +1244,31 @@ namespace s3d
 		return dir;
 	}
 
+	// QuestZDoom's OffhandDir() for mods (2026-10-29, quest-compat): MapAttackDir's maths on the off hand's pose, with
+	// the same pointing convention the off-hand fields use. No off hand tracked: the actor's own aim.
+	static DVector3 MapOffhandDir(AActor* actor, DAngle yaw, DAngle pitch)
+	{
+		LSMatrix44 mat;
+		auto vrmode = VRMode::GetVRMode(true);
+		if (!vrmode->GetHandTransform(openvr_rightHanded ? 0 : 1, &mat))
+		{
+			double pc = pitch.Cos();
+			return { pc * yaw.Cos(), pc * yaw.Sin(), -pitch.Sin() };
+		}
+		mat.rotate(openvr_weaponRotate, 1, 0, 0);
+
+		yaw -= actor->Angles.Yaw;
+		pitch -= actor->Angles.Pitch;
+		double pc = pitch.Cos();
+		LSVec3 local = { (float)(pc * yaw.Cos()), (float)(pc * yaw.Sin()), (float)(-pitch.Sin()), 0.0f };
+
+		DVector3 dir;
+		dir.X = local.x * -mat[2][0] + local.y * -mat[0][0] + local.z * -mat[1][0];
+		dir.Y = local.x * -mat[2][2] + local.y * -mat[0][2] + local.z * -mat[1][2];
+		dir.Z = local.x * -mat[2][1] + local.y * -mat[0][1] + local.z * -mat[1][1];
+		dir.MakeUnit();
+		return dir;
+	}
 
 
 	/* virtual */
@@ -1761,6 +1786,8 @@ namespace s3d
 
 
 					player->mo->AttackDir = MapAttackDir;
+					player->mo->OffhandDir = MapOffhandDir;	// QuestZDoom compatibility
+					player->PlayInVR = true;
 
 					vec3_t weaponangles;
 					int hand = openvr_rightHanded ? 1 : 0;
@@ -1777,7 +1804,7 @@ namespace s3d
 					player->mo->AttackRoll = DAngle::fromDeg(weaponangles[ROLL]);
 
 				}
-				// Off hand, for mods (ZScript: OffhandValid, OffhandPos, OffhandDir, OffhandAngle/Pitch/Roll)
+				// Off hand, for mods (ZScript: OffhandValid, OffhandPos, OffhandForward, OffhandAngle/Pitch/Roll; OffhandDir() is QuestZDoom's function)
 				{
 					LSMatrix44 off;
 					int offhand = openvr_rightHanded ? 0 : 1;
@@ -1788,7 +1815,7 @@ namespace s3d
 						player->mo->OffhandPos = DVector3(off[3][0], off[3][2], off[3][1]);
 						DVector3 dir(-off[2][0], -off[2][2], -off[2][1]);
 						dir.MakeUnit();
-						player->mo->OffhandDir = dir;
+						player->mo->OffhandForward = dir;
 						player->mo->OffhandAngle = dir.Angle();
 						player->mo->OffhandPitch = -DAngle::fromRad(asin(clamp(dir.Z, -1.0, 1.0)));
 						HmdVector3d_t e = eulerAnglesFromMatrix(controllers[offhand].pose.mDeviceToAbsoluteTracking);
