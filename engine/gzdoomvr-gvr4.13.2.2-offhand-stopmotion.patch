From 2ae22faec2392d7e9c99ab9e27af0f8adce7ef63 Mon Sep 17 00:00:00 2001
From: TefMeister <td3kxlvr@proton.me>
Date: Thu, 17 Sep 2026 17:59:31 +0300
Subject: [PATCH] VR: off-hand pose for mods; stop-motion weapon hand (toggle +
 rate slider)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../rendering/hwrenderer/data/hw_vrmodes.cpp  |  4 ++
 src/playsim/actor.h                           |  8 ++++
 src/rendering/gl/stereo3d/gl_openvr.cpp       | 44 +++++++++++++++++--
 src/rendering/gl/stereo3d/gl_openvr.h         |  1 +
 src/scripting/vmthunks_actors.cpp             |  6 +++
 wadsrc/static/menudef.txt                     |  2 +
 wadsrc/static/zscript/actors/actor.zs         |  6 +++
 7 files changed, 68 insertions(+), 3 deletions(-)

diff --git a/src/common/rendering/hwrenderer/data/hw_vrmodes.cpp b/src/common/rendering/hwrenderer/data/hw_vrmodes.cpp
index e2f1f7e..eff0f24 100644
--- a/src/common/rendering/hwrenderer/data/hw_vrmodes.cpp
+++ b/src/common/rendering/hwrenderer/data/hw_vrmodes.cpp
@@ -61,6 +61,10 @@ CVAR(Bool, openvr_moveFollowsOffHand, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Bool, openvr_drawControllers, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Float, openvr_weaponRotate, -40.0f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Float, openvr_weaponScale, 0.3f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+// Stop-motion weapon hand: the weapon follows the controller only a few times a second,
+// while the world and the view stay smooth. Rate = updates per second.
+CVAR(Bool, vr_weapon_stopmotion, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
+CVAR(Int, vr_weapon_stopmotion_rate, 12, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 
 CVAR(Bool, vr_snap_turn, false, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
 CVAR(Float, vr_snap_angle, 45.f, CVAR_ARCHIVE | CVAR_GLOBALCONFIG)
diff --git a/src/playsim/actor.h b/src/playsim/actor.h
index 0f92c92..19d5932 100644
--- a/src/playsim/actor.h
+++ b/src/playsim/actor.h
@@ -1656,6 +1656,14 @@ public:
 	DAngle   AttackAngle;
 	DAngle  AttackRoll;
 
+	//For VR, the off hand (the one not holding the weapon), for mods
+	bool OffhandValid;
+	DVector3 OffhandPos;
+	DVector3 OffhandDir;
+	DAngle   OffhandAngle;
+	DAngle   OffhandPitch;
+	DAngle   OffhandRoll;
+
 	DVector3 (*AttackDir)(AActor* actor, DAngle yaw, DAngle pitch);
 };
 
diff --git a/src/rendering/gl/stereo3d/gl_openvr.cpp b/src/rendering/gl/stereo3d/gl_openvr.cpp
index 95377d9..7712acd 100644
--- a/src/rendering/gl/stereo3d/gl_openvr.cpp
+++ b/src/rendering/gl/stereo3d/gl_openvr.cpp
@@ -29,6 +29,7 @@
 
 #ifdef USE_OPENVR
 
+#include <chrono>
 #include <string>
 #include <map>
 #include "gl_load/gl_system.h"
@@ -148,6 +149,8 @@ EXTERN_CVAR(Bool, vr_snap_turn);
 EXTERN_CVAR(Bool, openvr_drawControllers)
 EXTERN_CVAR(Float, openvr_weaponRotate);
 EXTERN_CVAR(Float, openvr_weaponScale);
+EXTERN_CVAR(Bool, vr_weapon_stopmotion);
+EXTERN_CVAR(Int, vr_weapon_stopmotion_rate);
 
 EXTERN_CVAR(Bool, vr_enable_haptics);
 EXTERN_CVAR(Float, vr_kill_momentum)
@@ -460,6 +463,8 @@ namespace s3d
 	{
 		bool active = false;
 		TrackedDevicePose_t pose;
+		TrackedDevicePose_t heldPose;	// stop-motion: the pose the weapon is frozen at
+		double heldTime = 0;			// seconds, when heldPose was last refreshed
 		VRControllerState_t lastState;
 		VRControllerModel* model = nullptr;
 	};
@@ -1043,6 +1048,11 @@ namespace s3d
 
 
 	bool OpenVRMode::GetHandTransform(int hand, VSMatrix* mat) const
+	{
+		return GetHandTransformEx(hand, mat, false);
+	}
+
+	bool OpenVRMode::GetHandTransformEx(int hand, VSMatrix* mat, bool held) const
 	{
 		if (controllers[hand].active)
 		{
@@ -1064,7 +1074,7 @@ namespace s3d
 			mat->translate(-openvr_origin.x, -vr_floor_offset, -openvr_origin.z);
 
 			LSMatrix44 handToAbs;
-			vSMatrixFromHmdMatrix34(handToAbs, controllers[hand].pose.mDeviceToAbsoluteTracking);
+			vSMatrixFromHmdMatrix34(handToAbs, (held ? controllers[hand].heldPose : controllers[hand].pose).mDeviceToAbsoluteTracking);
 			mat->multMatrix(handToAbs.transpose());
 			
 			return true;
@@ -1074,7 +1084,7 @@ namespace s3d
 
 	bool OpenVRMode::GetWeaponTransform(VSMatrix* out) const
 	{
-		if (GetHandTransform(openvr_rightHanded ? 1 : 0, out))
+		if (GetHandTransformEx(openvr_rightHanded ? 1 : 0, out, vr_weapon_stopmotion))
 		{
 			out->rotate(openvr_weaponRotate, 1, 0, 0);
 			if (!openvr_rightHanded)
@@ -1559,6 +1569,16 @@ namespace s3d
 					}
 					controllers[role].active = true;
 					controllers[role].pose = pose;
+					{
+						// stop-motion weapon hand: refresh the frozen pose only N times a second
+						double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+						int rate = clamp<int>(vr_weapon_stopmotion_rate, 1, 60);
+						if (!vr_weapon_stopmotion || now - controllers[role].heldTime >= 1.0 / rate || now < controllers[role].heldTime)
+						{
+							controllers[role].heldPose = pose;
+							controllers[role].heldTime = now;
+						}
+					}
 					if (controllerMeshes[model_name].isLoaded())
 					{
 						controllers[role].model = &controllerMeshes[model_name];
@@ -1623,7 +1643,7 @@ namespace s3d
 
 					vec3_t weaponangles;
 					int hand = openvr_rightHanded ? 1 : 0;
-					HmdVector3d_t eulerAngles = eulerAnglesFromMatrix(controllers[hand].pose.mDeviceToAbsoluteTracking);
+					HmdVector3d_t eulerAngles = eulerAnglesFromMatrix((vr_weapon_stopmotion ? controllers[hand].heldPose : controllers[hand].pose).mDeviceToAbsoluteTracking);
 					weaponangles[YAW] = RAD2DEG(eulerAngles.v[0]);
 					weaponangles[PITCH] = -RAD2DEG(eulerAngles.v[1]);
 					weaponangles[ROLL] = normalizeAngle(-RAD2DEG(eulerAngles.v[2]) + 180.);
@@ -1636,6 +1656,24 @@ namespace s3d
 					player->mo->AttackRoll = DAngle::fromDeg(weaponangles[ROLL]);
 
 				}
+				// Off hand, for mods (ZScript: OffhandValid, OffhandPos, OffhandDir, OffhandAngle/Pitch/Roll)
+				{
+					LSMatrix44 off;
+					int offhand = openvr_rightHanded ? 0 : 1;
+					player->mo->OffhandValid = GetHandTransform(offhand, &off);
+					if (player->mo->OffhandValid)
+					{
+						off.rotate(openvr_weaponRotate, 1, 0, 0);	// same "pointing" convention as the weapon hand
+						player->mo->OffhandPos = DVector3(off[3][0], off[3][2], off[3][1]);
+						DVector3 dir(-off[2][0], -off[2][2], -off[2][1]);
+						dir.MakeUnit();
+						player->mo->OffhandDir = dir;
+						player->mo->OffhandAngle = dir.Angle();
+						player->mo->OffhandPitch = -DAngle::fromRad(asin(clamp(dir.Z, -1.0, 1.0)));
+						HmdVector3d_t e = eulerAnglesFromMatrix(controllers[offhand].pose.mDeviceToAbsoluteTracking);
+						player->mo->OffhandRoll = DAngle::fromDeg(normalizeAngle(-RAD2DEG(e.v[2]) + 180.));
+					}
+				}
 				if (GetHandTransform(openvr_rightHanded ? 0 : 1, &mat) && openvr_moveFollowsOffHand)
 				{
 					player->mo->ThrustAngleOffset = DAngle::fromDeg(RAD2DEG(atan2f(-mat[2][2], -mat[2][0]))) - player->mo->Angles.Yaw;
diff --git a/src/rendering/gl/stereo3d/gl_openvr.h b/src/rendering/gl/stereo3d/gl_openvr.h
index 2202463..6c27b1a 100644
--- a/src/rendering/gl/stereo3d/gl_openvr.h
+++ b/src/rendering/gl/stereo3d/gl_openvr.h
@@ -118,6 +118,7 @@ public:
 	virtual void DrawControllerModels(HWDrawInfo* di, FRenderState& state) const override;
 	
 	virtual bool GetHandTransform(int hand, VSMatrix* out) const override;
+	bool GetHandTransformEx(int hand, VSMatrix* out, bool held) const;
 	virtual bool GetWeaponTransform(VSMatrix* out) const override;
 	virtual bool RenderPlayerSpritesCrossed() const { return true; }
 	virtual bool RenderPlayerSpritesInScene() const { return true; }
diff --git a/src/scripting/vmthunks_actors.cpp b/src/scripting/vmthunks_actors.cpp
index 3c340ec..c7d5749 100644
--- a/src/scripting/vmthunks_actors.cpp
+++ b/src/scripting/vmthunks_actors.cpp
@@ -2139,6 +2139,12 @@ DEFINE_FIELD(AActor, AttackDir)
 DEFINE_FIELD(AActor, AttackPitch)
 DEFINE_FIELD(AActor, AttackRoll)
 DEFINE_FIELD(AActor, AttackAngle)
+DEFINE_FIELD(AActor, OffhandValid)
+DEFINE_FIELD(AActor, OffhandPos)
+DEFINE_FIELD(AActor, OffhandDir)
+DEFINE_FIELD(AActor, OffhandAngle)
+DEFINE_FIELD(AActor, OffhandPitch)
+DEFINE_FIELD(AActor, OffhandRoll)
 
 DEFINE_FIELD_X(FCheckPosition, FCheckPosition, thing);
 DEFINE_FIELD_X(FCheckPosition, FCheckPosition, pos);
diff --git a/wadsrc/static/menudef.txt b/wadsrc/static/menudef.txt
index bba4cfe..c3ad6ec 100644
--- a/wadsrc/static/menudef.txt
+++ b/wadsrc/static/menudef.txt
@@ -2767,6 +2767,8 @@ OptionMenu "OpenVROptions" protected
 	Slider "$VRPREFMNU_FATITEMWIDTH",			gl_fatItemWidth,						0, 1, 0.05, 2
 	Slider "$VRPREFMNU_WEAPONSCALE",			openvr_weaponScale,						0, 1, 0.05, 2
 	Option "$VRPREFMNU_DRAWCONTROLLERS",		openvr_drawControllers,					"OnOff"
+	Option "Stop-motion weapon hand",			vr_weapon_stopmotion,					"OnOff"
+	Slider "Stop-motion updates per second",	vr_weapon_stopmotion_rate,				2, 35, 1, 0
 	StaticText " "
 	StaticText "$VRPREFMNU_HAPTICS"
 	Option "$VRPREFMNU_ENABLEHAPTICS",	    	vr_enable_haptics, "OnOff"
diff --git a/wadsrc/static/zscript/actors/actor.zs b/wadsrc/static/zscript/actors/actor.zs
index 3e56350..b4e56a2 100644
--- a/wadsrc/static/zscript/actors/actor.zs
+++ b/wadsrc/static/zscript/actors/actor.zs
@@ -872,6 +872,12 @@ class Actor : Thinker native
 	native readonly double AttackRoll;
 	native readonly double AttackAngle;
 	native readonly bool OverrideAttackPosDir;
+	native readonly bool OffhandValid;
+	native readonly vector3 OffhandPos;
+	native readonly vector3 OffhandDir;
+	native readonly double OffhandAngle;
+	native readonly double OffhandPitch;
+	native readonly double OffhandRoll;
 
 	native vector3 AttackDir(Actor actor, double angle, double pitch);
 
-- 
