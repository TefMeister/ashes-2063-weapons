@@ -1657,6 +1657,7 @@ public:
 	DAngle  AttackRoll;
 
 	//For VR, the off hand (the one not holding the weapon), for mods
+	bool FollowOffhand;	// set by a mod on any actor: draw it rigidly at the off hand, every rendered frame
 	bool OffhandValid;
 	DVector3 OffhandPos;
 	DVector3 OffhandDir;
diff --git a/src/r_data/models.cpp b/src/r_data/models.cpp
index 9ac7a4b..d108811 100644
--- a/src/r_data/models.cpp
+++ b/src/r_data/models.cpp
@@ -26,6 +26,7 @@
 **
 **/
 
+#include "hw_vrmodes.h"
 #include "filesystem.h"
 #include "cmdlib.h"
 #include "sc_man.h"
@@ -86,6 +87,11 @@ void RenderModel(FModelRenderer *renderer, float x, float y, float z, FSpriteMod
 	else
 		angles = actor->Angles;
 	float angle = angles.Yaw.Degrees();
+	if (actor->FollowOffhand)
+	{
+		double hx, hy, hz, hyaw;
+		if (VRMode::GetVRMode(true)->GetOffhandRenderPos(&hx, &hy, &hz, &hyaw)) angle = (float)hyaw;
+	}
 
 	// [BB] Workaround for the missing pitch information.
 	if ((smf_flags & MDL_PITCHFROMMOMENTUM))
diff --git a/src/rendering/hwrenderer/scene/hw_sprites.cpp b/src/rendering/hwrenderer/scene/hw_sprites.cpp
index 83f3c1a..52949d5 100644
--- a/src/rendering/hwrenderer/scene/hw_sprites.cpp
+++ b/src/rendering/hwrenderer/scene/hw_sprites.cpp
@@ -59,6 +59,7 @@
 #include "hw_lightbuffer.h"
 #include "hw_renderstate.h"
 #include "quaternion.h"
+#include "hw_vrmodes.h"
 
 extern TArray<spritedef_t> sprites;
 extern TArray<spriteframe_t> SpriteFrames;
@@ -806,6 +807,13 @@ void HWSprite::Process(HWDrawInfo *di, AActor* thing, sector_t * sector, area_t
 
 	// [RH] Interpolate the sprite's position to make it look smooth
 	DVector3 thingpos = thing->InterpolatedPosition(vp.TicFrac);
+	if (thing->FollowOffhand)
+	{
+		// VR: held in the off hand. Use the controller's pose of THIS rendered frame, like the weapon,
+		// instead of the once-per-tic actor position (which lags and rubber-bands).
+		double hx, hy, hz, hyaw;
+		if (VRMode::GetVRMode(true)->GetOffhandRenderPos(&hx, &hy, &hz, &hyaw)) thingpos = DVector3(hx, hy, hz);
+	}
 	if (thruportal == 1) thingpos += di->Level->Displacements.getOffset(thing->Sector->PortalGroup, sector->PortalGroup);
 
 	AActor *viewmaster = thing;
