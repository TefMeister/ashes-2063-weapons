+
+				// Two-handed long guns (2026-09-19). When a mod asks for it, the shot follows the
+				// line between the two hands instead of the rear controller's own tilt. It sits
+				// here on purpose: OffhandPos above is this frame's, and AttackAngle/AttackPitch
+				// just above are the values everything downstream will use.
+				// Guarded twice, and refusing means "leave the aim exactly as it is today", so the
+				// worst case is the behaviour we already have. See two_handed_aim.h beside this file.
+				if (player->mo->TwoHandedAim && player->mo->OffhandValid && player->mo->OverrideAttackPosDir)
+				{
+					tha::Hands hh;
+					hh.rear_x  = player->mo->AttackPos.X;  hh.rear_y  = player->mo->AttackPos.Y;  hh.rear_z  = player->mo->AttackPos.Z;
+					hh.front_x = player->mo->OffhandPos.X; hh.front_y = player->mo->OffhandPos.Y; hh.front_z = player->mo->OffhandPos.Z;
+					// The weapon hand's own forward, written in the SAME convention the engine
+					// actually shoots along (p_map.cpp: { pc*angle.Cos(), pc*angle.Sin(), -pitch.Sin() }).
+					// Do NOT use the TRotator -> TVector3 helper here: its Z is +sin(pitch), the
+					// opposite sign, and the gun would quietly shoot as far high as it should be low.
+					const double pc = player->mo->AttackPitch.Cos();
+					hh.fwd_x = pc * player->mo->AttackAngle.Cos();
+					hh.fwd_y = pc * player->mo->AttackAngle.Sin();
+					hh.fwd_z = -player->mo->AttackPitch.Sin();
+
