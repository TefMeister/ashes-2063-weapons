+								aim.use ? "USED" : "refused");
+						}
+					}
+					if (aim.use)
+					{
+						player->mo->AttackAngle = DAngle::fromDeg(aim.yaw_deg);
+						player->mo->AttackPitch = DAngle::fromDeg(aim.pitch_deg);
+					}
