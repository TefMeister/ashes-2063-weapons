+// Is the weapon hand drawn at a held (frozen or gliding) pose instead of the live one?
+// Standing rule (Tefa 2026-11-02): only while a real GUN is in hand. A melee weapon, anything named
+// in vr_weapon_glide_raw (throwables), and empty hands always follow the controller raw. The check
+// lives here, in the engine, and is not a menu setting.
+static bool WeaponHandHeld()
+{
+	if (!vr_weapon_stopmotion && !vr_weapon_glide) return false;
+	const player_t& p = players[consoleplayer];
+	if (p.mo == nullptr || p.ReadyWeapon == nullptr) return false;
+	if (p.ReadyWeapon->IntVar(NAME_WeaponFlags) & WIF_MELEEWEAPON) return false;
+	FString name = p.ReadyWeapon->GetClass()->TypeName.GetChars();
+	name.ToLower();
+	FString raw = *vr_weapon_glide_raw;
+	raw.ToLower();
+	auto names = raw.Split(",", FString::TOK_SKIPEMPTY);
+	for (auto& n : names)
+	{
+		n.StripLeftRight();
+		if (n.IsNotEmpty() && name.IndexOf(n) >= 0) return false;
+	}
+	return true;
+}
